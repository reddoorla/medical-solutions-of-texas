{
  "format": "custom",
  "id": "resources_page",
  "label": "Resources page",
  "repeatable": false,
  "status": true,
  "json": {
    "Resources": {
      "heading": {
        "type": "Text",
        "config": {
          "label": "page heading",
          "placeholder": "Leave empty to keep: Resources"
        }
      }
    },
    "Charge Sheet": {
      "charge_heading": {
        "type": "Text",
        "config": {
          "label": "heading",
          "placeholder": "Leave empty to keep: CHARGE SHEET"
        }
      },
      "charge_button": {
        "type": "Text",
        "config": {
          "label": "button",
          "placeholder": "Leave empty to keep: DOWNLOAD"
        }
      },
      "charge_file": {
        "type": "Link",
        "config": {
          "label": "the charge sheet (a PDF)",
          "placeholder": "Leave empty to keep today's file, MSOT_ChargeSheet.pdf",
          "select": "media"
        }
      },
      "phone_label": {
        "type": "Text",
        "config": {
          "label": "word before the phone number (the address and number are in Settings)",
          "placeholder": "Leave empty to keep: Phone:"
        }
      },
      "service_email": {
        "type": "Text",
        "config": {
          "label": "customer service email",
          "placeholder": "Leave empty to keep: customerservice@MedicalSolutionsofTX.com"
        }
      },
      "contact_button": {
        "type": "Text",
        "config": {
          "label": "button to the Contact page",
          "placeholder": "Leave empty to keep: Contact Us"
        }
      }
    },
    "Capabilities Statement": {
      "capabilities_heading": {
        "type": "Text",
        "config": {
          "label": "heading",
          "placeholder": "Leave empty to keep: CAPABILITIES STATEMENT"
