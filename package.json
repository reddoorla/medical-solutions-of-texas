{
  "name": "medical-solutions-of-texas",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently \"pnpm:vite:dev\" \"pnpm:slicemachine\" --prefix-colors blue,magenta",
    "vite:dev": "vite dev",
    "vite:devHost": "vite dev --host --port 8888",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . --plugin prettier-plugin-svelte . && eslint .",
    "format": "prettier --write . --plugin prettier-plugin-svelte .",
    "slicemachine": "start-slicemachine"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.60.0",
    "@reddoorla/maintenance": "^0.58.0",
    "@slicemachine/adapter-sveltekit": "^0.3.60",
    "@sveltejs/adapter-netlify": "^6.0.4",
    "@sveltejs/kit": "^2.68.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "concurrently": "^9.1.2",
    "eslint": "^10.2.1",
    "prettier": "^3.1.1",
    "prettier-plugin-svelte": "^3.2.6",
    "slice-machine-ui": "^2.11.1",
    "svelte": "^5.23.0",
    "svelte-check": "^4.0.0",
    "typescript": "^6.0.3",
    "typescript-svelte-plugin": "^0.3.36",
    "vite": "^8.0.2"
  },
  "dependencies": {
    "@lucide/svelte": "^1.8.0",
    "@prismicio/client": "^7.3.1",
    "@prismicio/svelte": "^2.0.0",
    "@tailwindcss/vite": "^4.2.4",
    "@zerodevx/svelte-img": "^2.1.2",
    "svelte-gestures": "^5.2.2",
    "svelte-select": "^5.8.3",
    "tailwindcss": "^4.2.4"
  }
}
