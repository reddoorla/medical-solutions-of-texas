          "label": "heading",
          "placeholder": "Leave empty to keep: Catalogs"
        }
      },
      "catalogs": {
        "type": "Group",
        "config": {
          "label": "the catalogs, in order",
          "repeat": true,
          "fields": {
            "title": {
              "type": "Text",
              "config": {
                "label": "title",
                "placeholder": "Needed, with a file, or the row is not shown. The rows replace the whole list; with none, the page keeps today's two (the FSS one names the FSS contract number in Settings)."
              }
            },
            "file": {
              "type": "Link",
              "config": {
                "label": "file (opens in a new tab)",
                "select": "media"
              }
            }
          }
        }
      }
    },
    "Suppliers": {
      "suppliers_heading": {
        "type": "Text",
